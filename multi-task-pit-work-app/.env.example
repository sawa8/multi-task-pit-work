# Turso (LibSQL) データベース接続
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Google OAuth 認証
# Google Cloud Console で取得した OAuth クライアントID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Expo クライアント側で使う Google Client ID
# EXPO_PUBLIC_ プレフィックスが必要（Expo のビルド時に埋め込まれる）
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 管理者メールアドレス（カンマ区切りで複数指定可）
# このメールでログインしたユーザーは自動的に admin になる
ADMIN_EMAILS=admin@example.com

# CORS 許可オリジン
# デプロイ先のURLを指定（末尾スラッシュなし）
ALLOWED_ORIGIN=https://multi-task-pit-work-app.vercel.app
